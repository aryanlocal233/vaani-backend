# Bhashini ULCA API credentials (https://bhashini.gov.in)
BHASHINI_API_KEY=your_bhashini_api_key_here
BHASHINI_USER_ID=your_bhashini_user_id_here
BHASHINI_BASE_URL=https://dhruva-api.bhashini.gov.in

# Optional fallback providers — leave blank to disable fallback
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
GOOGLE_TRANSLATE_KEY=

# Redis connection string
REDIS_URL=redis://localhost:6379

# Session limits
MAX_SESSIONS=100
SESSION_TTL_SECONDS=3600

# Audio pipeline
AUDIO_SAMPLE_RATE=16000
CHUNK_TIMEOUT_SECONDS=30.0

# Logging: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# CORS: "*" for all origins, or comma-separated list
CORS_ALLOW_ORIGINS=*
